{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/components/ProfilePage.js",
    "app/components/SignupPage.js",
    "app/(tabs)/index.js",
    "app/AnnouncementPageUser.js/api.js",
    "nativewind-env.d.ts"
  ]
}